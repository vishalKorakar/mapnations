---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import { fetchArticles, fetchArticleBySlug, STRAPI_URL } from '../../lib/strapi';
import { renderBlocks } from '../../lib/render';

export async function getStaticPaths() {
  const articles = await fetchArticles();
  return articles
    .filter((a: any) => a.slug != null && a.slug !== '')
    .map((a: any) => ({
      params: { slug: String(a.slug) },
    }));
}

const { slug } = Astro.params;
const article = await fetchArticleBySlug(slug);

if (!article) {
  return Astro.redirect('/404');
}

// Navigation: previous/next articles
const allArticles = await fetchArticles();
const currentIndex = allArticles.findIndex((a: any) => a.slug === slug);
const prevArticle = currentIndex < allArticles.length - 1 ? allArticles[currentIndex + 1] : null;
const nextArticle = currentIndex > 0 ? allArticles[currentIndex - 1] : null;

// Format date
const formattedDate = article.articleDate
  ? new Date(article.articleDate).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    })
  : null;

// Get featured image URL
const getFeaturedImageUrl = () => {
  const img = article.image || article.featuredImage;
  if (img?.url) return `${STRAPI_URL}${img.url}`;
  return null;
};
const featuredImageUrl = getFeaturedImageUrl();

// Render content blocks, prepending STRAPI_URL to image src values
const rawContent = renderBlocks(article.Contents || []);
const articleContent = rawContent.replace(
  /src="(\/uploads\/[^"]+)"/g,
  `src="${STRAPI_URL}$1"`
);

// This article's categories (for post-meta line)
const categories = (article.categories || [])
  .map((c: any) => c.categoryTitle?.trim())
  .filter(Boolean);

// All categories for the dropdown (from all articles)
const categoryCounts = new Map<string, number>();
allArticles.forEach((a: any) => {
  (a.categories || []).forEach((c: any) => {
    if (c.categoryTitle) {
      const t = c.categoryTitle.trim();
      categoryCounts.set(t, (categoryCounts.get(t) || 0) + 1);
    }
  });
});
const allCategories = Array.from(categoryCounts.keys()).sort();
---

<Layout>
  <div id="wrapper">
    <Header />
    <div id="content-container" class="clearfix">

      <aside id="sidebar">
        <div class="hr"><hr /></div>
        <div class="sidebar-content">
          <div>
            <h3>Categories</h3>
            <div class="category-dropdown-wrap">
              <select id="category-select" class="category-select">
                <option value="">All Posts</option>
                {allCategories.map((cat: string) => (
                  <option value={cat}>{cat} ({categoryCounts.get(cat) || 0})</option>
                ))}
              </select>
              <span class="dropdown-arrow">&#9662;</span>
            </div>

            <h3>Links</h3>
            <ul>
              <li><a href="http://www.bostonraremaps.com/default.htm">Boston Rare Maps</a></li>
              <li><a href="http://antiqueprintsblog.blogspot.com/">Chris Lane's antique prints blog</a></li>
              <li><a href="http://www.davidrumsey.com" title="Enormous collection of maps.">David Rumsey Map Collection</a></li>
              <li><a href="http://bigthink.com/blogs/strange-maps/">Frank Jacobs Strange Maps</a></li>
              <li><a href="http://makingmaps.net/">Johy Krygier's Making Maps</a></li>
              <li><a href="http://maps.bpl.org/" title="Historic maps at the BPL">Maps at the Boston Public Library</a></li>
            </ul>

            <h3>Subscribe</h3>
            <ul>
              <li><a href="/blog/feed">Entries (RSS)</a></li>
            </ul>
          </div>
        </div>
      </aside>

      <section id="content" class="browse blog-post">

        <h1>{article.title}</h1>

        <p class="post-meta">
          {formattedDate && <span>{formattedDate}</span>}
          {categories.length > 0 && (
            <span>
              {' | '}
              {categories.map((cat: string, i: number) => (
                <span>
                  <a href={`/blog?category=${encodeURIComponent(cat)}`}>{cat}</a>
                  {i < categories.length - 1 && ', '}
                </span>
              ))}
            </span>
          )}
          {' | '}
          <a href="#comments">No Comments »</a>
        </p>

        <div class="post-body" set:html={articleContent} />

        {featuredImageUrl && (
          <div class="featured-image-viewer">
            <div class="viewer-frame">
              <div class="pan-container" id="pan-container">
                <img
                  id="viewer-img"
                  src={featuredImageUrl}
                  alt={article.title}
                />
              </div>
              <div class="viewer-controls">
                <button class="ctrl-btn" id="zoom-in" title="Zoom in">+</button>
                <div class="ctrl-group">
                  <button class="ctrl-btn small" id="pan-left" title="Pan left">&#8249;</button>
                  <button class="ctrl-btn small" id="pan-reset" title="Reset">&#10005;</button>
                  <button class="ctrl-btn small" id="pan-right" title="Pan right">&#8250;</button>
                </div>
                <button class="ctrl-btn" id="zoom-out" title="Zoom out">&minus;</button>
                <button class="ctrl-btn arrow" id="pan-up" title="Pan up">&#8743;</button>
                <button class="ctrl-btn arrow" id="pan-down" title="Pan down">&#8744;</button>
              </div>
            </div>
            <p class="viewer-hint">Use controls to zoom and pan.</p>
          </div>
        )}

        <div class="post-navigation">
          <a href="/blog" class="nav-link">« Return to Blog Main Page</a>
          <div class="post-nav-right">
            {prevArticle && (
              <a href={`/blog/${prevArticle.slug}`} class="nav-link">« Previous Post</a>
            )}
            {prevArticle && nextArticle && <span class="nav-sep"> | </span>}
            {nextArticle && (
              <a href={`/blog/${nextArticle.slug}`} class="nav-link">Next Post »</a>
            )}
          </div>
        </div>

        <!-- Comments section -->
        <div id="comments" class="comments-section">
          <h2>Leave a Reply</h2>
          <form class="comment-form" onsubmit="return false;">
            <div class="form-row">
              <input type="text" name="name" id="comment-name" required />
              <label for="comment-name">Name (required)</label>
            </div>
            <div class="form-row">
              <input type="email" name="email" id="comment-email" required />
              <label for="comment-email">Mail (will not be published) (required)</label>
            </div>
            <div class="form-row">
              <input type="url" name="website" id="comment-website" />
              <label for="comment-website">Website</label>
            </div>
            <div class="form-row">
              <textarea name="comment" id="comment-text" rows="10"></textarea>
            </div>
            <div class="form-row">
              <button type="submit" class="submit-btn">Submit Comment</button>
            </div>
          </form>
        </div>

      </section>
    </div>
  </div>
  <Footer />
</Layout>

<script>
  // Category dropdown — navigate to /blog?category=...
  const select = document.getElementById('category-select') as HTMLSelectElement | null;
  select?.addEventListener('change', () => {
    const val = select.value;
    if (val) {
      window.location.href = `/blog?category=${encodeURIComponent(val)}`;
    } else {
      window.location.href = '/blog';
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('pan-container') as HTMLElement | null;
    const img = document.getElementById('viewer-img') as HTMLImageElement | null;
    if (!container || !img) return;

    let scale = 1;
    let tx = 0;
    let ty = 0;
    const STEP = 60;
    const SCALE_STEP = 0.25;
    const MIN_SCALE = 0.5;
    const MAX_SCALE = 4;

    function applyTransform() {
      img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    }

    document.getElementById('zoom-in')?.addEventListener('click', () => {
      scale = Math.min(scale + SCALE_STEP, MAX_SCALE);
      applyTransform();
    });
    document.getElementById('zoom-out')?.addEventListener('click', () => {
      scale = Math.max(scale - SCALE_STEP, MIN_SCALE);
      applyTransform();
    });
    document.getElementById('pan-reset')?.addEventListener('click', () => {
      scale = 1; tx = 0; ty = 0;
      applyTransform();
    });
    document.getElementById('pan-left')?.addEventListener('click', () => {
      tx -= STEP; applyTransform();
    });
    document.getElementById('pan-right')?.addEventListener('click', () => {
      tx += STEP; applyTransform();
    });
    document.getElementById('pan-up')?.addEventListener('click', () => {
      ty -= STEP; applyTransform();
    });
    document.getElementById('pan-down')?.addEventListener('click', () => {
      ty += STEP; applyTransform();
    });

    // Drag to pan
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragTx = 0;
    let dragTy = 0;

    container.addEventListener('mousedown', (e: MouseEvent) => {
      isDragging = true;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragTx = tx;
      dragTy = ty;
      container.style.cursor = 'grabbing';
    });
    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDragging) return;
      tx = dragTx + (e.clientX - dragStartX);
      ty = dragTy + (e.clientY - dragStartY);
      applyTransform();
    });
    window.addEventListener('mouseup', () => {
      isDragging = false;
      container.style.cursor = 'grab';
    });
  });
</script>

<style>
  /* Category dropdown */
  .category-dropdown-wrap {
    position: relative;
    width: 100%;
    margin-bottom: 22px;
  }
  .category-select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    background-color: #eeede3;
    border: 1px solid #c4b88d;
    border-radius: 0;
    color: #3d3725;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    line-height: 1.4;
    padding: 9px 30px 9px 12px;
    cursor: pointer;
    outline: none;
    transition: border-color 0.15s ease;
  }
  .category-select:hover {
    border-color: #004146;
  }
  .category-select:focus {
    border-color: #004146;
    box-shadow: 0 0 0 2px rgba(0, 65, 70, 0.12);
  }
  .dropdown-arrow {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: #004146;
    font-size: 13px;
    pointer-events: none;
    line-height: 1;
  }

  /* Article title */
  #content.blog-post h1 {
    font-family: 'CallunaBoldItalic', 'Times New Roman', Times, serif;
    color: #962f11;
    font-size: 2em;
    margin: 24px 0 8px 0;
    font-weight: normal;
    line-height: 1.2;
  }

  /* Post metadata line */
  .post-meta {
    font-size: 13px;
    color: #6b6242;
    margin-bottom: 24px;
    font-family: Arial, Helvetica, sans-serif;
  }
  .post-meta a {
    color: #962f11;
    text-decoration: none;
    font-style: italic;
  }
  .post-meta a:hover {
    text-decoration: underline;
    color: #000;
  }

  /* Article body content */
  .post-body {
    font-size: 15px;
    line-height: 1.7;
    color: #3d3725;
    font-family: Arial, Helvetica, sans-serif;
    margin-bottom: 30px;
  }
  .post-body p {
    margin-bottom: 18px;
  }
  .post-body h2, .post-body h3, .post-body h4 {
    font-family: 'CallunaBoldItalic', 'Times New Roman', Times, serif;
    color: #004146;
    margin: 20px 0 10px;
    font-weight: normal;
  }
  .post-body img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 20px auto;
    border: 1px solid #c9c2a8;
  }
  .post-body a {
    color: #004146;
    text-decoration: underline;
  }
  .post-body a:hover {
    color: #962f11;
  }
  .post-body blockquote {
    border-left: 3px solid #c4b88d;
    padding-left: 16px;
    margin: 16px 0;
    color: #6b6242;
    font-style: italic;
  }

  /* Image viewer */
  .featured-image-viewer {
    margin: 30px 0;
  }
  .viewer-frame {
    position: relative;
    border: 1px solid #c9c2a8;
    overflow: hidden;
    background: #1a1a1a;
    height: 420px;
    cursor: grab;
  }
  .pan-container {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .pan-container img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transform-origin: center center;
    transition: transform 0.15s ease;
    user-select: none;
    -webkit-user-drag: none;
  }
  .viewer-controls {
    position: absolute;
    bottom: 16px;
    right: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .ctrl-group {
    display: flex;
    flex-direction: row;
    gap: 2px;
  }
  .ctrl-btn {
    width: 32px;
    height: 32px;
    background: rgba(240, 236, 220, 0.92);
    border: 1px solid #888;
    border-radius: 3px;
    font-size: 16px;
    font-weight: bold;
    color: #333;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    padding: 0;
    transition: background 0.1s;
  }
  .ctrl-btn.small {
    width: 28px;
    height: 28px;
    font-size: 14px;
  }
  .ctrl-btn.arrow {
    font-size: 14px;
  }
  .ctrl-btn:hover {
    background: rgba(255, 255, 255, 1);
  }
  .viewer-hint {
    text-align: right;
    font-size: 12px;
    color: #6b6242;
    margin-top: 6px;
    font-style: italic;
    font-family: Arial, Helvetica, sans-serif;
  }

  /* Post navigation */
  .post-navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #c9c2a8;
    padding-top: 18px;
    margin: 30px 0 40px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
  }
  .post-nav-right {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-link {
    color: #004146;
    text-decoration: none;
    font-style: italic;
  }
  .nav-link:hover {
    text-decoration: underline;
    color: #962f11;
  }
  .nav-sep {
    color: #6b6242;
  }

  /* Comments section */
  .comments-section {
    border-top: 1px solid #c9c2a8;
    padding-top: 30px;
    margin-top: 10px;
  }
  .comments-section h2 {
    font-family: 'CallunaBoldItalic', 'Times New Roman', Times, serif;
    color: #004146;
    font-size: 1.5em;
    font-weight: normal;
    margin-bottom: 28px;
  }

  /* Comment form */
  .comment-form {
    max-width: 680px;
  }
  .form-row {
    display: flex;
    align-items: center;
    margin-bottom: 18px;
    gap: 14px;
  }
  .form-row input[type="text"],
  .form-row input[type="email"],
  .form-row input[type="url"] {
    width: 340px;
    min-width: 200px;
    padding: 8px 10px;
    border: 1px solid #c4b88d;
    background: #fafaf5;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    color: #3d3725;
    outline: none;
    border-radius: 0;
  }
  .form-row input:focus {
    border-color: #004146;
  }
  .form-row label {
    font-size: 13px;
    color: #3d3725;
    font-family: Arial, Helvetica, sans-serif;
    white-space: nowrap;
  }
  .form-row textarea {
    width: 100%;
    max-width: 680px;
    padding: 10px;
    border: 1px solid #c4b88d;
    background: #fafaf5;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    color: #3d3725;
    resize: vertical;
    outline: none;
    border-radius: 0;
  }
  .form-row textarea:focus {
    border-color: #004146;
  }
  .submit-btn {
    padding: 9px 24px;
    border: 1px solid #3d3725;
    background: #f5f3ea;
    color: #3d3725;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    cursor: pointer;
    border-radius: 0;
    transition: background 0.15s;
  }
  .submit-btn:hover {
    background: #e8e4d4;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .form-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .form-row input[type="text"],
    .form-row input[type="email"],
    .form-row input[type="url"] {
      width: 100%;
    }
    .post-navigation {
      flex-direction: column;
      gap: 10px;
      align-items: flex-start;
    }
    .viewer-frame {
      height: 260px;
    }
  }
</style>
