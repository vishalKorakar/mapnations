---
import Layout from '../../layouts/Layout.astro';
import { fetchMapsByPeriod, STRAPI_URL } from '../../lib/strapi';
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';

// Define the valid periods
const periods: Record<string, { start: number; end: number; label: string }> = {
  '1811-1840': { start: 1811, end: 1840, label: '1811–1840' },
  '1841-1860': { start: 1841, end: 1860, label: '1841–1860' },
  '1861-1870': { start: 1861, end: 1870, label: '1861–1870' },
  '1871-1880': { start: 1871, end: 1880, label: '1871–1880' },
  '1881-1932': { start: 1881, end: 1932, label: '1881–1932' },
};

// Required for static site generation - tells Astro which pages to build
export function getStaticPaths() {
  return [
    { params: { period: '1811-1840' } },
    { params: { period: '1841-1860' } },
    { params: { period: '1861-1870' } },
    { params: { period: '1871-1880' } },
    { params: { period: '1881-1932' } },
  ];
}

const { period } = Astro.params;
const periodConfig = periods[period ?? ''];

if (!periodConfig) {
  return Astro.redirect('/404');
}

const maps = await fetchMapsByPeriod(periodConfig.start, periodConfig.end);

// Helper to get image URL
const getImageUrl = (map: any) => {
  const img = map.image;
  if (!img) return null;
  const file = img.formats?.thumbnail ?? img;
  return file?.url ? `${STRAPI_URL}${file.url}` : null;
};
---

<Layout>
  <div id="wrapper">
    <Header />
    <div id="content-container" class="clearfix">
      <section id="content" class="browse chrono">
        <h1><span>Maps from {periodConfig.label}</span></h1>
        <p>{maps.length} map{maps.length !== 1 ? 's' : ''} found</p>

        {maps.length > 0 ? (
          maps.map((map: any) => {
            const imgUrl = getImageUrl(map);
            return (
              <article>
                {imgUrl && (
                  <a href={`/maps/${map.slug}`}>
                    <img src={imgUrl} alt={map.mapTitle} loading="lazy" />
                  </a>
                )}
                <h3>
                  <a href={`/maps/${map.slug}`}>{map.mapTitle}</a>
                </h3>
                <p>{map.Description}</p>
                <p class="map-meta">
                  {map.creatorName && <span>{map.creatorName}</span>}
                  {map.mapYear && <span> | {map.mapYear}</span>}
                </p>
              </article>
            );
          })
        ) : (
          <p>No maps found for this time period.</p>
        )}
      </section>
    </div>
  </div>
  <Footer />
</Layout>