---
import Layout from '../../layouts/Layout.astro';
import { fetchMaps, fetchMapBySlug, toAbsoluteUrl } from '../../lib/strapi';
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';

// Get all maps for static paths
export async function getStaticPaths() {
  const maps = await fetchMaps();
  return maps
    .filter((map: any) => map.slug != null && map.slug !== '')
    .map((map: any) => ({
      params: { slug: String(map.slug) },
    }));
}

const { slug } = Astro.params;
const map = await fetchMapBySlug(slug);

if (!map) {
  return Astro.redirect('/404');
}

// Get full-size image URL
const getImageUrl = (format?: string) => {
  const img = map.image;
  if (!img) return null;
  if (format && img.formats?.[format]) {
    return toAbsoluteUrl(img.formats[format].url);
  }
  return toAbsoluteUrl(img.url);
};

const fullImageUrl = getImageUrl();

// Get all maps for navigation (exclude maps with missing/invalid slugs)
const allMaps = (await fetchMaps()).filter((m: any) => m.slug != null && m.slug !== '' && m.slug !== 'null' && m.slug !== 'undefined');
const currentIndex = allMaps.findIndex((m: any) => m.slug === slug);
const prevMap = currentIndex > 0 ? allMaps[currentIndex - 1] : null;
const nextMap = currentIndex < allMaps.length - 1 ? allMaps[currentIndex + 1] : null;
const firstMap = allMaps[0];
const lastMap = allMaps[allMaps.length - 1];

// Metadata fields to display (add AdminstrativeNotes and LocalIdentifiers)
const metadata = [
  { label: 'Title', value: map.mapTitle },
  { label: 'Alternate Title', value: map.AlternateTitle },
  { label: 'Creator', value: map.creatorName, isLink: true, searchIn: 'creator' },
  { label: 'Type of Resource', value: map.TypeofResource },
  { label: 'Date Created', value: map.DateCreated },
  { label: 'Digital Origin', value: map.DigitalOrigin },
  { label: 'Topics', value: map.Topics, isLink: true, searchIn: 'topic' },
  { label: 'Places', value: map.Places },
  { label: 'Dates', value: map.Dates },
  { label: 'Subject Genre', value: map.SubjectGenre },
  { label: 'Handle', value: map.Handle },
  { label: 'Rights Statement', value: map.RightsStatement },
  { label: 'Publisher', value: map.Publisher },
  { label: 'Language', value: map.Language },
  { label: 'Extent', value: map.Extent },
  { label: 'Physical Note', value: map.PhysicalNote },
  { label: 'Scale', value: map.Scale },
  { label: 'Coordinates', value: map.Coordinates },
  { label: 'Notes', value: map.Notes },
  { label: 'Administrative Notes', value: map.AdministrativeNotes },
  { label: 'Local Identifiers', value: map.LocalIdentifiers },
].filter((item) => item.value);
---

<Layout>
    <div id="wrapper">
    <Header />
  <div id="content-container" class="clearfix">
    
    <!-- Navigation -->
    <table class="map-nav-table">
      <tbody>
        <tr>
          <td class="nav-spacer">&nbsp;</td>
          <td class="nav-cell">
            {firstMap && currentIndex > 0 ? (
              <a class="duViewerLink" href={`/maps/${firstMap.slug}`}>First</a>
            ) : (
              <span class="disabled-link">First</span>
            )}
          </td>
          <td class="nav-cell nav-cell-wide">
            {prevMap ? (
              <a class="duViewerLink" href={`/maps/${prevMap.slug}`}>Previous</a>
            ) : (
              <span class="disabled-link">Previous</span>
            )}
          </td>
          <td class="nav-cell">
            {nextMap ? (
              <a class="duViewerLink" href={`/maps/${nextMap.slug}`}>Next</a>
            ) : (
              <span class="disabled-link">Next</span>
            )}
          </td>
          <td class="nav-cell">
            {lastMap && currentIndex < allMaps.length - 1 ? (
              <a class="duViewerLink" href={`/maps/${lastMap.slug}`}>Last</a>
            ) : (
              <span class="disabled-link">Last</span>
            )}
          </td>
          <td class="nav-spacer-end">&nbsp;</td>
        </tr>
      </tbody>
    </table>

    <!-- Tabs -->
    <div id="tabs" class="ui-tabs ui-widget ui-widget-content ui-corner-all">
      <ul class="ui-tabs-nav ui-helper-reset ui-helper-clearfix ui-widget-header ui-corner-all" role="tablist">
        <li class="ui-state-default ui-corner-top ui-tabs-active ui-state-active" role="tab" tabindex="0" aria-controls="tabs-1" aria-labelledby="ui-id-1" aria-selected="true">
          <a href="#tabs-1" class="ui-tabs-anchor" role="presentation" tabindex="-1" id="ui-id-1">Viewer</a>
        </li>
        <li class="ui-state-default ui-corner-top" role="tab" tabindex="-1" aria-controls="tabs-2" aria-labelledby="ui-id-2" aria-selected="false">
          <a href="#tabs-2" class="ui-tabs-anchor" role="presentation" tabindex="-1" id="ui-id-2">Overview</a>
        </li>
      </ul>

      <!-- Viewer Tab -->
      <div id="tabs-1" aria-labelledby="ui-id-1" class="ui-tabs-panel ui-widget-content ui-corner-bottom" role="tabpanel" aria-expanded="true" aria-hidden="false">
        <div id="iframe" class="viewer-container">
          
          {fullImageUrl ? (
            <div class="zoom-container">
              <!-- Main image with lens -->
              <div class="img-zoom-container" id="img-zoom-container">
                <img 
                  id="map-image" 
                  src={fullImageUrl} 
                  alt={map.mapTitle}
                />
                <div id="zoom-lens" class="img-zoom-lens"></div>
              </div>
              
              <!-- Zoomed result panel -->
              <div id="zoom-result" class="img-zoom-result"></div>
            </div>
            
            <p class="zoom-hint desktop-hint">Hover over image to zoom • Click to open full size</p>
            <p class="zoom-hint mobile-hint">Pinch to zoom • Double-tap to zoom • Drag to pan</p>
          ) : (
            <p>No image available for this map.</p>
          )}
        </div>
      </div>

      <!-- Overview Tab -->
      <div id="tabs-2" aria-labelledby="ui-id-2" class="ui-tabs-panel ui-widget-content ui-corner-bottom" role="tabpanel" aria-expanded="false" aria-hidden="true">
        
        <table class="metadata-table">
          <tbody>
            {metadata.map((item) => (
              <tr>
                <td class="heading">{item.label}</td>
                <td class="mapData">
                  {item.isLink ? (
                    <a href={`/search?searchText=${encodeURIComponent(item.value)}&searchIn=${item.searchIn || ''}`}>
                      {item.value}
                    </a>
                  ) : (
                    <Fragment set:html={String(item.value).replace(/\n/g, '<br>')} />
                  )}
                  <br />
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        {map.Description && (
          <table class="metadata-table" style="margin-top: 20px;">
            <tbody>
              <tr>
                <td class="heading">Description</td>
                <td class="mapData">{map.Description}<br /></td>
              </tr>
            </tbody>
          </table>
        )}

      </div>
    </div>
  </div>
  </div>
  <Footer />
</Layout>

<script>
  // Tab switching functionality
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.ui-tabs-nav li');
    const panel1 = document.getElementById('tabs-1');
    const panel2 = document.getElementById('tabs-2');
    
    if (!panel1 || !panel2) return;
    
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        
        // Update tab states
        tabs.forEach((t) => {
          t.classList.remove('ui-tabs-active', 'ui-state-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('ui-tabs-active', 'ui-state-active');
        tab.setAttribute('aria-selected', 'true');
        
        // Update panel visibility
        if (index === 0) {
          panel1.style.display = 'block';
          panel1.setAttribute('aria-hidden', 'false');
          panel1.setAttribute('aria-expanded', 'true');
          panel2.style.display = 'none';
          panel2.setAttribute('aria-hidden', 'true');
          panel2.setAttribute('aria-expanded', 'false');
        } else {
          panel1.style.display = 'none';
          panel1.setAttribute('aria-hidden', 'true');
          panel1.setAttribute('aria-expanded', 'false');
          panel2.style.display = 'block';
          panel2.setAttribute('aria-hidden', 'false');
          panel2.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Amazon-style image zoom
    const imgEl = document.getElementById('map-image') as HTMLImageElement | null;
    const lensEl = document.getElementById('zoom-lens') as HTMLElement | null;
    const resultEl = document.getElementById('zoom-result') as HTMLElement | null;
    const containerEl = document.getElementById('img-zoom-container') as HTMLElement | null;
    
    if (imgEl && lensEl && resultEl && containerEl) {
      // Store references to avoid null checks in nested functions
      const img = imgEl;
      const lens = lensEl;
      const result = resultEl;
      const container = containerEl;
      
      // Zoom ratio (how much to magnify)
      const zoomRatio = 2.5;
      
      // Wait for image to load to get dimensions
      function initZoom() {
        // Set lens size (smaller = more precise)
        const lensWidth = 150;
        const lensHeight = 150;
        lens.style.width = lensWidth + 'px';
        lens.style.height = lensHeight + 'px';
        
        // Set result size
        result.style.width = (lensWidth * zoomRatio) + 'px';
        result.style.height = (lensHeight * zoomRatio) + 'px';
        
        // Set background image for result
        result.style.backgroundImage = `url('${img.src}')`;
        result.style.backgroundSize = `${img.width * zoomRatio}px ${img.height * zoomRatio}px`;
      }
      
      img.onload = initZoom;
      if (img.complete) initZoom();
      
      // Mouse move handler
      function moveLens(e: MouseEvent) {
        e.preventDefault();
        
        const rect = img.getBoundingClientRect();
        
        // Get cursor position relative to image
        let x = e.clientX - rect.left;
        let y = e.clientY - rect.top;
        
        // Calculate lens position (center on cursor)
        const lensW = lens.offsetWidth;
        const lensH = lens.offsetHeight;
        let lensX = x - lensW / 2;
        let lensY = y - lensH / 2;
        
        // Prevent lens from going outside image
        if (lensX < 0) lensX = 0;
        if (lensY < 0) lensY = 0;
        if (lensX > img.width - lensW) lensX = img.width - lensW;
        if (lensY > img.height - lensH) lensY = img.height - lensH;
        
        // Position the lens
        lens.style.left = lensX + 'px';
        lens.style.top = lensY + 'px';
        
        // Calculate and set background position for result
        const bgX = lensX * zoomRatio;
        const bgY = lensY * zoomRatio;
        result.style.backgroundPosition = `-${bgX}px -${bgY}px`;
        
        // Position floating result panel near cursor
        const resultW = result.offsetWidth;
        const resultH = result.offsetHeight;
        const padding = 20; // Gap between cursor and panel
        
        // Try to position to the right of cursor
        let resultX = e.clientX + padding;
        let resultY = e.clientY - resultH / 2;
        
        // If it goes off the right edge, position to the left
        if (resultX + resultW > window.innerWidth - 10) {
          resultX = e.clientX - resultW - padding;
        }
        
        // Keep within vertical bounds
        if (resultY < 10) resultY = 10;
        if (resultY + resultH > window.innerHeight - 10) {
          resultY = window.innerHeight - resultH - 10;
        }
        
        result.style.left = resultX + 'px';
        result.style.top = resultY + 'px';
      }
      
      // Show/hide zoom on hover
      container.addEventListener('mouseenter', () => {
        lens.style.display = 'block';
        result.style.display = 'block';
      });
      
      container.addEventListener('mouseleave', () => {
        lens.style.display = 'none';
        result.style.display = 'none';
      });
      
      container.addEventListener('mousemove', moveLens);
      lens.addEventListener('mousemove', moveLens);
      
      // Click to open full size in new tab
      img.addEventListener('click', () => {
        window.open(img.src, '_blank');
      });
      
      img.style.cursor = 'crosshair';
    }

    // ── Mobile touch zoom ──────────────────────────────────────────
    const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

    if (isTouchDevice && imgEl && containerEl) {
      // Hide the desktop hover-zoom elements entirely on touch
      if (lensEl) lensEl.style.display = 'none';
      if (resultEl) resultEl.style.display = 'none';
      if (imgEl) imgEl.style.cursor = 'default';

      // Remove the desktop mouse listeners so they don't interfere
      containerEl.removeEventListener('mouseenter', () => {});
      containerEl.removeEventListener('mouseleave', () => {});

      const touchImg = imgEl;
      const touchContainer = containerEl;

      touchContainer.style.overflow = 'hidden';

      let scale = 1;
      let translateX = 0;
      let translateY = 0;

      // Pinch state
      let startPinchDist = 0;
      let startPinchScale = 1;

      // Pan state
      let panStartX = 0;
      let panStartY = 0;
      let panStartTX = 0;
      let panStartTY = 0;

      // Double-tap state
      let lastTapTime = 0;

      function getPinchDist(t0: Touch, t1: Touch) {
        const dx = t0.clientX - t1.clientX;
        const dy = t0.clientY - t1.clientY;
        return Math.sqrt(dx * dx + dy * dy);
      }

      function clamp() {
        const cW = touchContainer.offsetWidth;
        const cH = touchContainer.offsetHeight;
        const iW = touchImg.offsetWidth;
        const iH = touchImg.offsetHeight;
        const scaledW = iW * scale;
        const scaledH = iH * scale;
        const minX = scaledW > cW ? cW - scaledW : 0;
        const minY = scaledH > cH ? cH - scaledH : 0;
        translateX = Math.min(0, Math.max(minX, translateX));
        translateY = Math.min(0, Math.max(minY, translateY));
      }

      function applyTransform() {
        touchImg.style.transformOrigin = '0 0';
        touchImg.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
      }

      function resetZoom() {
        scale = 1;
        translateX = 0;
        translateY = 0;
        applyTransform();
      }

      touchContainer.addEventListener('touchstart', (e: TouchEvent) => {
        if (e.touches.length === 2) {
          e.preventDefault();
          startPinchDist = getPinchDist(e.touches[0], e.touches[1]);
          startPinchScale = scale;
        } else if (e.touches.length === 1) {
          const now = Date.now();
          if (now - lastTapTime < 280) {
            // Double-tap: toggle zoom
            e.preventDefault();
            if (scale > 1) {
              resetZoom();
            } else {
              const rect = touchImg.getBoundingClientRect();
              const tapX = e.touches[0].clientX - rect.left;
              const tapY = e.touches[0].clientY - rect.top;
              scale = 2.5;
              translateX = -(tapX * (scale - 1));
              translateY = -(tapY * (scale - 1));
              clamp();
              applyTransform();
            }
            lastTapTime = 0;
            return;
          }
          lastTapTime = now;

          if (scale > 1) {
            e.preventDefault();
            panStartX = e.touches[0].clientX;
            panStartY = e.touches[0].clientY;
            panStartTX = translateX;
            panStartTY = translateY;
          }
        }
      }, { passive: false });

      touchContainer.addEventListener('touchmove', (e: TouchEvent) => {
        if (e.touches.length === 2) {
          e.preventDefault();
          const dist = getPinchDist(e.touches[0], e.touches[1]);
          scale = Math.min(5, Math.max(1, startPinchScale * (dist / startPinchDist)));
          clamp();
          applyTransform();
        } else if (e.touches.length === 1 && scale > 1) {
          e.preventDefault();
          translateX = panStartTX + (e.touches[0].clientX - panStartX);
          translateY = panStartTY + (e.touches[0].clientY - panStartY);
          clamp();
          applyTransform();
        }
      }, { passive: false });

      touchContainer.addEventListener('touchend', () => {
        if (scale < 1.05) resetZoom();
      });
    }
  });
</script>

<style>
  .zoom-container {
    display: block;
    padding: 20px;
    text-align: center;
  }
  
  .img-zoom-container {
    position: relative;
    display: inline-block;
    max-width: 600px;
  }
  
  .img-zoom-container img {
    display: block;
    max-width: 100%;
    height: auto;
    cursor: crosshair;
  }
  
  .img-zoom-lens {
    position: absolute;
    border: 2px solid #8b4513;
    background-color: rgba(139, 69, 19, 0.15);
    display: none;
    pointer-events: none;
    z-index: 10;
    border-radius: 4px;
  }
  
  .img-zoom-result {
    position: fixed;
    border: 3px solid #8b4513;
    background-color: #fff;
    background-repeat: no-repeat;
    display: none;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    border-radius: 8px;
    z-index: 9999;
    pointer-events: none;
  }
  
  .zoom-hint {
    text-align: center;
    color: #666;
    font-size: 13px;
    margin-top: 10px;
    font-style: italic;
  }

  /* Show desktop hint on pointer devices, mobile hint on touch */
  .mobile-hint { display: none; }

  @media (pointer: coarse) {
    .desktop-hint { display: none; }
    .mobile-hint { display: block; }

    .img-zoom-container {
      overflow: hidden;
      touch-action: none;
      cursor: default !important;
    }

    .img-zoom-container img {
      cursor: default !important;
      transition: transform 0.1s ease;
      will-change: transform;
    }

    /* Hide the desktop lens/result on touch screens */
    .img-zoom-lens,
    .img-zoom-result {
      display: none !important;
    }
  }
</style>
