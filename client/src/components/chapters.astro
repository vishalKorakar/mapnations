---
import { fetchChapters, toAbsoluteUrl } from "../lib/strapi.js";

const chapters = await fetchChapters();

const chapterItems = (chapters ?? []).map((c: any) => {
  const title = c?.title ?? "";
  const slug = c?.slug ?? "";
  const Description = c?.Description ?? "";
  const rawThumb = c?.chapterImage?.formats?.thumbnail?.url || c?.chapterImage?.url || null;

  return {
    title,
    slug,
    Description,
    imageUrl: toAbsoluteUrl(rawThumb),
  };
});
---

<style>
  .chapter-thumb {
    width: 245px;
    height: 185px;
    object-fit: cover;
    display: block;
  }
</style>

<section id="content" class="chapter-list">
  <h2><span>Browse Images by Book Chapter</span></h2>

  {chapterItems.map((c: any) => (
    <article class="chapter">
      <a href={`/chapters/${c.slug}`}>
        {c.imageUrl && <img src={c.imageUrl} alt={`${c.title} image`} class="chapter-thumb" />}
      </a>

      <h3>
        <a href={`/chapters/${c.slug}`}>{c.title}</a>
      </h3>

      {c.Description && <p>{c.Description}</p>}

      <p class="chapter-link">
        <a href={`/chapters/${c.slug}`}>View {c.title} Maps »</a>
      </p>
    </article>
  ))}
</section>